# Treelife Arcade - Environment Variables
# Copy this file to .env.local and fill in the values.
#
# DATABASE_URL: PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
#
# IMPORTANT: Change the password to a strong, unique value before deploying.
# Do NOT use the development default password in production.

DATABASE_URL=postgresql://treelife_user:CHANGE_ME_TO_A_STRONG_PASSWORD@localhost:5432/treelife_arcade
